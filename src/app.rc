#include <winres.h>
#include "resource.h"

IDI_APP ICON "res\\app.ico"

IDR_HTML RCDATA "ui\\index.html"
IDR_CSS RCDATA "ui\\style.css"
IDR_JS RCDATA "ui\\app.js"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Roblox FPS Manager"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "RobloxFpsManager"
            VALUE "OriginalFilename", "RobloxFpsManager.exe"
            VALUE "ProductName", "Roblox FPS Manager"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
